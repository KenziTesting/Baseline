# Baseline — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.

# --- Supabase (required for auth + persistence) ---
# From your Supabase project settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, used by migrations/seed scripts. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (Phase 7: Coach chat + plan explanation). Not required for Phase 1. ---
ANTHROPIC_API_KEY=

# --- YouTube Data API v3 (drill demo videos). Server-side only; app degrades to cues without it. ---
# search.list costs 100 of 10,000 daily quota units — cache aggressively (curate offline).
YOUTUBE_API_KEY=

# --- WHOOP (Phase 3). Requires an APPROVED WHOOP developer account. ---
# App works without these — it degrades to a self-report check-in (or demo data).
# Create an app at developer.whoop.com. Redirect URI must exactly match the one
# registered there. For local dev use: http://localhost:3000/api/whoop/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/whoop/callback

# --- Google Calendar (Phase 4). Not required for Phase 1. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
